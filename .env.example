# Copy to .env and fill in. .env is never committed or shared.

# Twitch (free): https://dev.twitch.tv/console -> Register Application -> copy Client ID + generate Secret
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Twitch category name. Use "Grand Theft Auto V" for testing until the GTA 6 category exists.
TWITCH_GAME_NAME=Grand Theft Auto VI

# Gemini (free tier): https://aistudio.google.com/apikey  -> titles, commentary script
GEMINI_API_KEY=

# Shown in the description so creators can reach you (use a real address you check)
CONTACT_EMAIL=

# MongoDB (defaults shown; the dashboard stores clips, videos and jobs in database gta6_studio)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=gta6_studio

# edge-tts voice for the commentary narrator (free, no key). List: python -m edge_tts --list-voices
TTS_VOICE=en-US-GuyNeural
