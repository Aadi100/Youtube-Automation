# ===== Two files hold your settings on the server =====
# 1) ".env" NEXT TO docker-compose.yml  (read by Docker Compose)  -> copy the block "A" below
# 2) "config/.env"  (read by the app; the dashboard Settings page edits it) -> copy the block "B" below

# ---------------------------------------------------------------- A) .env next to docker-compose.yml
# DOMAIN=studio.yourdomain.com
# MAX_CONCURRENT_JOBS=2        # videos rendered at once per worker container (about 1 per CPU core you can spare)
# UPLOAD_THREADS=2
# MEMBER_STORAGE_MB=3000       # disk each member may use
# WORKER_MEMORY=6g

# ---------------------------------------------------------------- B) config/.env  (the dashboard can fill most of these in)
# PUBLIC_BASE_URL=https://studio.yourdomain.com      <- needed: used in approval emails and the Google sign-in redirect
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# YT_DAILY_UNITS=10000                               # raise it after Google approves a bigger YouTube quota
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# NOTIFY_TO=
# TOKEN_ENC_KEY=      <- when you MOVE from your PC, copy this exact value from the old .env (it unlocks members' saved YouTube logins)
