# The video makers of one Clip Studio: renders videos, runs the schedule, uploads to YouTube and cleans up old files. A template: deploy/setup_vps.sh
# fills in the @@...@@ parts and installs it as /etc/systemd/system/<name>-worker.service. It serves no website, so restarting the dashboard
# never interrupts a video being made.
[Unit]
Description=@@APP_NAME@@ video workers (Clip Studio)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@@APP_USER@@
WorkingDirectory=@@APP_DIR@@
Environment=PYTHONUNBUFFERED=1
# this studio's own Node.js comes first, so yt-dlp finds it and the system's Node.js is never touched
Environment=PATH=@@APP_DIR@@/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=STUDIO_ROLE=worker
Environment=STUDIO_PORT=@@PORT@@
Environment=HF_HOME=@@APP_DIR@@/state/cache/hf
Environment=XDG_CACHE_HOME=@@APP_DIR@@/state/cache
ExecStartPre=/usr/bin/touch @@APP_DIR@@/.env
ExecStart=@@APP_DIR@@/venv/bin/python -u worker.py
Restart=always
RestartSec=5
# stopping the service also stops the ffmpeg / yt-dlp processes it started
KillMode=control-group
TimeoutStopSec=60
LimitNOFILE=65535
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
