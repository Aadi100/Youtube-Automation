[
  {
    "id": "gta6Compilation01",
    "name": "Clip Studio - Auto Compilation (any game, 8-10 min, upload unlisted)",
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "minutes",
                "minutesInterval": 5
              }
            ]
          }
        },
        "id": "n-sch",
        "name": "Schedule",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [
          200,
          300
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://127.0.0.1:8765/api/schedule/claim/compilation",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "X-Requested-With",
                "value": "studio"
              }
            ]
          },
          "options": {}
        },
        "id": "n-claim",
        "name": "Is it due? (dashboard schedule)",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          330,
          300
        ]
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "loose"
            },
            "conditions": [
              {
                "id": "c1",
                "leftValue": "={{ $json.run }}",
                "rightValue": "",
                "operator": {
                  "type": "boolean",
                  "operation": "true",
                  "singleValue": true
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "id": "n-gate",
        "name": "Time to run?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          480,
          300
        ]
      },
      {
        "parameters": {},
        "id": "n-man",
        "name": "Manual test run",
        "type": "n8n-nodes-base.manualTrigger",
        "typeVersion": 1,
        "position": [
          200,
          480
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://127.0.0.1:8765/run",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "X-Requested-With",
                "value": "studio"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={ \"mode\": \"auto-compilation\", \"game_id\": \"auto\", \"source\": \"all\", \"audio_mode\": \"replace\", \"count\": 14, \"target_minutes\": 8 }",
          "options": {
            "timeout": 3600000
          }
        },
        "id": "n-run",
        "name": "Run pipeline",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          460,
          380
        ]
      },
      {
        "parameters": {
          "url": "http://127.0.0.1:8765/file",
          "sendQuery": true,
          "queryParameters": {
            "parameters": [
              {
                "name": "path",
                "value": "={{ $('Run pipeline').item.json.video_path }}"
              }
            ]
          },
          "options": {
            "response": {
              "response": {
                "responseFormat": "file",
                "outputPropertyName": "data"
              }
            },
            "timeout": 600000
          }
        },
        "id": "n-vid",
        "name": "Fetch video",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          700,
          380
        ]
      },
      {
        "parameters": {
          "resource": "video",
          "operation": "upload",
          "title": "={{ $('Run pipeline').item.json.title }}",
          "regionCode": "US",
          "categoryId": "20",
          "binaryProperty": "data",
          "options": {
            "description": "={{ $('Run pipeline').item.json.description }}",
            "privacyStatus": "unlisted",
            "tags": "={{ $('Run pipeline').item.json.tags.join(',') }}",
            "selfDeclaredMadeForKids": false
          }
        },
        "id": "n-up",
        "name": "Upload to YouTube (Unlisted)",
        "type": "n8n-nodes-base.youTube",
        "typeVersion": 1,
        "position": [
          940,
          380
        ],
        "credentials": {
          "youTubeOAuth2Api": {
            "id": "gta6YtCred01",
            "name": "YouTube - GTA6 Studio"
          }
        }
      },
      {
        "parameters": {
          "method": "POST",
          "url": "=http://127.0.0.1:8765/api/videos/{{ $('Run pipeline').item.json.video_id }}/uploaded",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "X-Requested-With",
                "value": "studio"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={ \"youtube_id\": \"{{ $('Upload to YouTube (Unlisted)').item.json.uploadId }}\", \"privacy_status\": \"unlisted\" }",
          "options": {}
        },
        "id": "n-rep",
        "name": "Report to dashboard",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1180,
          380
        ]
      },
      {
        "parameters": {
          "url": "http://127.0.0.1:8765/file",
          "sendQuery": true,
          "queryParameters": {
            "parameters": [
              {
                "name": "path",
                "value": "={{ $('Run pipeline').item.json.thumbnail_path }}"
              }
            ]
          },
          "options": {
            "response": {
              "response": {
                "responseFormat": "file",
                "outputPropertyName": "data"
              }
            },
            "timeout": 600000
          }
        },
        "id": "n-thumb",
        "name": "Fetch thumbnail",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1420,
          380
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "=https://www.googleapis.com/upload/youtube/v3/thumbnails/set?videoId={{ $('Upload to YouTube (Unlisted)').item.json.uploadId }}&uploadType=media",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "youTubeOAuth2Api",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Content-Type",
                "value": "image/jpeg"
              }
            ]
          },
          "sendBody": true,
          "contentType": "binaryData",
          "inputDataFieldName": "data"
        },
        "id": "n-thumb-set",
        "name": "Set custom thumbnail",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1660,
          380
        ],
        "credentials": {
          "youTubeOAuth2Api": {
            "id": "gta6YtCred01",
            "name": "YouTube - GTA6 Studio"
          }
        }
      },
      {
        "parameters": {
          "content": "Games come from the dashboard Games tab: game_id 'auto' rotates through every enabled game; put a game id here to always use one. Needs:(1) `python worker.py` running in the gta6_automation folder, (2) YouTube OAuth2 credential on the upload node, (3) .env filled (Twitch + Gemini keys), (4) royalty-free tracks in music/. Uploads as UNLISTED: check Content ID, then set Public. Custom thumbnails need a phone-verified YouTube channel. Rendering 8-10 min takes a while: the run node waits up to 1h.",
          "width": 520,
          "height": 280
        },
        "id": "n-note",
        "name": "Setup notes",
        "type": "n8n-nodes-base.stickyNote",
        "typeVersion": 1,
        "position": [
          200,
          80
        ]
      }
    ],
    "connections": {
      "Schedule": {
        "main": [
          [
            {
              "node": "Is it due? (dashboard schedule)",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Is it due? (dashboard schedule)": {
        "main": [
          [
            {
              "node": "Time to run?",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Time to run?": {
        "main": [
          [
            {
              "node": "Run pipeline",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Run pipeline": {
        "main": [
          [
            {
              "node": "Fetch video",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Fetch video": {
        "main": [
          [
            {
              "node": "Upload to YouTube (Unlisted)",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Upload to YouTube (Unlisted)": {
        "main": [
          [
            {
              "node": "Report to dashboard",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Report to dashboard": {
        "main": [
          [
            {
              "node": "Fetch thumbnail",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Fetch thumbnail": {
        "main": [
          [
            {
              "node": "Set custom thumbnail",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Manual test run": {
        "main": [
          [
            {
              "node": "Run pipeline",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    },
    "settings": {
      "executionOrder": "v1",
      "executionTimeout": 7200,
      "timezone": "Asia/Karachi"
    },
    "active": false
  }
]