[
  {
    "id": "gta6Publish01",
    "name": "Clip Studio - Approve & publish (webhook)",
    "active": false,
    "settings": {
      "executionOrder": "v1"
    },
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "clip-studio-publish",
          "responseMode": "lastNode",
          "options": {}
        },
        "id": "p-hook",
        "name": "Publish webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          200,
          300
        ],
        "webhookId": "7d3c1f0a-5b8e-4c1d-9a52-3f6b2c8d1e40"
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "strict"
            },
            "conditions": [
              {
                "id": "c1",
                "leftValue": "={{ $json.headers['x-studio-secret'] }}",
                "rightValue": "REPLACE_WITH_YOUR_STUDIO_SECRET",
                "operator": {
                  "type": "string",
                  "operation": "equals"
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "id": "p-if",
        "name": "Secret OK?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          420,
          300
        ]
      },
      {
        "parameters": {
          "method": "PUT",
          "url": "https://www.googleapis.com/youtube/v3/videos?part=status",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "youTubeOAuth2Api",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={ \"id\": \"{{ $('Publish webhook').item.json.body.youtube_id }}\", \"status\": { \"privacyStatus\": \"public\", \"embeddable\": true, \"publicStatsViewable\": true, \"license\": \"youtube\", \"selfDeclaredMadeForKids\": false } }",
          "options": {}
        },
        "id": "p-yt",
        "name": "Set video Public",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          660,
          220
        ],
        "credentials": {
          "youTubeOAuth2Api": {
            "id": "gta6YtCred01",
            "name": "YouTube - GTA6 Studio"
          }
        }
      },
      {
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "r1",
                "name": "error",
                "value": "forbidden",
                "type": "string"
              }
            ]
          },
          "options": {}
        },
        "id": "p-rej",
        "name": "Reject",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [
          660,
          400
        ]
      },
      {
        "parameters": {
          "content": "Called by the dashboard when you click Approve in the notification email (or Publish in the Videos tab). Makes the video Public. Only requests with the shared secret are accepted. Keep this workflow ACTIVE.",
          "width": 440,
          "height": 120
        },
        "id": "p-note",
        "name": "Notes",
        "type": "n8n-nodes-base.stickyNote",
        "typeVersion": 1,
        "position": [
          200,
          100
        ]
      }
    ],
    "connections": {
      "Publish webhook": {
        "main": [
          [
            {
              "node": "Secret OK?",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Secret OK?": {
        "main": [
          [
            {
              "node": "Set video Public",
              "type": "main",
              "index": 0
            }
          ],
          [
            {
              "node": "Reject",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    }
  }
]