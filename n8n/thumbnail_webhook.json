[
  {
    "id": "gta6Thumb01",
    "name": "Clip Studio - Set YouTube thumbnail (webhook)",
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "clip-studio-thumbnail",
          "responseMode": "lastNode",
          "options": {}
        },
        "id": "t-hook",
        "name": "Thumbnail webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          200,
          300
        ],
        "webhookId": "5c8a1e93-7d24-4b6f-9e30-1a2b3c4d5e6f"
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "strict"
            },
            "conditions": [
              {
                "id": "c1",
                "leftValue": "={{ $json.headers['x-studio-secret'] }}",
                "rightValue": "REPLACE_WITH_YOUR_STUDIO_SECRET",
                "operator": {
                  "type": "string",
                  "operation": "equals"
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "id": "t-if",
        "name": "Secret OK?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          420,
          300
        ]
      },
      {
        "parameters": {
          "url": "http://127.0.0.1:8765/file",
          "sendQuery": true,
          "queryParameters": {
            "parameters": [
              {
                "name": "path",
                "value": "={{ $('Thumbnail webhook').item.json.body.thumbnail_path }}"
              }
            ]
          },
          "options": {
            "response": {
              "response": {
                "responseFormat": "file",
                "outputPropertyName": "data"
              }
            },
            "timeout": 120000
          }
        },
        "id": "t-fetch",
        "name": "Fetch thumbnail",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          660,
          220
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "=https://www.googleapis.com/upload/youtube/v3/thumbnails/set?videoId={{ $('Thumbnail webhook').item.json.body.youtube_id }}&uploadType=media",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "youTubeOAuth2Api",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Content-Type",
                "value": "image/jpeg"
              }
            ]
          },
          "sendBody": true,
          "contentType": "binaryData",
          "inputDataFieldName": "data",
          "options": {}
        },
        "id": "t-set",
        "name": "Set YouTube thumbnail",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          900,
          220
        ],
        "credentials": {
          "youTubeOAuth2Api": {
            "id": "gta6YtCred01",
            "name": "YouTube - GTA6 Studio"
          }
        }
      },
      {
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "r1",
                "name": "ok",
                "value": "true",
                "type": "string"
              }
            ]
          },
          "options": {}
        },
        "id": "t-res",
        "name": "Result",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [
          1140,
          220
        ]
      },
      {
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "r2",
                "name": "error",
                "value": "forbidden",
                "type": "string"
              }
            ]
          },
          "options": {}
        },
        "id": "t-rej",
        "name": "Reject",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [
          660,
          440
        ]
      },
      {
        "parameters": {
          "content": "Called by the dashboard to put the AI thumbnail on a video that is already on YouTube. Only requests with the shared secret are accepted. Keep this workflow ACTIVE.",
          "width": 460,
          "height": 110
        },
        "id": "t-note",
        "name": "Notes",
        "type": "n8n-nodes-base.stickyNote",
        "typeVersion": 1,
        "position": [
          200,
          80
        ]
      }
    ],
    "connections": {
      "Thumbnail webhook": {
        "main": [
          [
            {
              "node": "Secret OK?",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Secret OK?": {
        "main": [
          [
            {
              "node": "Fetch thumbnail",
              "type": "main",
              "index": 0
            }
          ],
          [
            {
              "node": "Reject",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Fetch thumbnail": {
        "main": [
          [
            {
              "node": "Set YouTube thumbnail",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Set YouTube thumbnail": {
        "main": [
          [
            {
              "node": "Result",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    },
    "settings": {
      "executionOrder": "v1"
    },
    "active": false
  }
]