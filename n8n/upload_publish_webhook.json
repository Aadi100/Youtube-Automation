[
  {
    "id": "gta6UploadPub01",
    "name": "Clip Studio - Upload & publish (webhook)",
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "clip-studio-upload",
          "responseMode": "lastNode",
          "options": {}
        },
        "id": "u-hook",
        "name": "Upload webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          200,
          300
        ],
        "webhookId": "9b4e2d71-6c3a-4f08-8e15-2a7d5c1b9f63"
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "strict"
            },
            "conditions": [
              {
                "id": "c1",
                "leftValue": "={{ $json.headers['x-studio-secret'] }}",
                "rightValue": "REPLACE_WITH_YOUR_STUDIO_SECRET",
                "operator": {
                  "type": "string",
                  "operation": "equals"
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "id": "u-if",
        "name": "Secret OK?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          420,
          300
        ]
      },
      {
        "parameters": {
          "url": "http://127.0.0.1:8765/file",
          "sendQuery": true,
          "queryParameters": {
            "parameters": [
              {
                "name": "path",
                "value": "={{ $('Upload webhook').item.json.body.video_path }}"
              }
            ]
          },
          "options": {
            "response": {
              "response": {
                "responseFormat": "file",
                "outputPropertyName": "data"
              }
            },
            "timeout": 600000
          }
        },
        "id": "u-vid",
        "name": "Fetch video",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          660,
          220
        ]
      },
      {
        "parameters": {
          "resource": "video",
          "operation": "upload",
          "title": "={{ $('Upload webhook').item.json.body.title }}",
          "regionCode": "US",
          "categoryId": "20",
          "binaryProperty": "data",
          "options": {
            "description": "={{ $('Upload webhook').item.json.body.description }}",
            "privacyStatus": "={{ $('Upload webhook').item.json.body.privacy }}",
            "tags": "={{ ($('Upload webhook').item.json.body.tags || []).join(',') }}",
            "selfDeclaredMadeForKids": false
          }
        },
        "id": "u-up",
        "name": "Upload to YouTube",
        "type": "n8n-nodes-base.youTube",
        "typeVersion": 1,
        "position": [
          900,
          220
        ],
        "credentials": {
          "youTubeOAuth2Api": {
            "id": "gta6YtCred01",
            "name": "YouTube - GTA6 Studio"
          }
        }
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "loose"
            },
            "conditions": [
              {
                "id": "k1",
                "leftValue": "={{ $('Upload webhook').item.json.body.kind }}",
                "rightValue": "compilation",
                "operator": {
                  "type": "string",
                  "operation": "equals"
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "id": "u-kind",
        "name": "Is it a compilation?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          1120,
          220
        ]
      },
      {
        "parameters": {
          "url": "http://127.0.0.1:8765/file",
          "sendQuery": true,
          "queryParameters": {
            "parameters": [
              {
                "name": "path",
                "value": "={{ $('Upload webhook').item.json.body.thumbnail_path }}"
              }
            ]
          },
          "options": {
            "response": {
              "response": {
                "responseFormat": "file",
                "outputPropertyName": "data"
              }
            },
            "timeout": 600000
          }
        },
        "id": "u-tf",
        "name": "Fetch thumbnail",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1340,
          120
        ],
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "method": "POST",
          "url": "=https://www.googleapis.com/upload/youtube/v3/thumbnails/set?videoId={{ $('Upload to YouTube').item.json.uploadId }}&uploadType=media",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "youTubeOAuth2Api",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Content-Type",
                "value": "image/jpeg"
              }
            ]
          },
          "sendBody": true,
          "contentType": "binaryData",
          "inputDataFieldName": "data"
        },
        "id": "u-ts",
        "name": "Set custom thumbnail",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1560,
          120
        ],
        "credentials": {
          "youTubeOAuth2Api": {
            "id": "gta6YtCred01",
            "name": "YouTube - GTA6 Studio"
          }
        },
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "r1",
                "name": "youtube_id",
                "value": "={{ $('Upload to YouTube').item.json.uploadId }}",
                "type": "string"
              }
            ]
          },
          "options": {}
        },
        "id": "u-res",
        "name": "Result",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [
          1780,
          220
        ]
      },
      {
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "r2",
                "name": "error",
                "value": "forbidden",
                "type": "string"
              }
            ]
          },
          "options": {}
        },
        "id": "u-rej",
        "name": "Reject",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [
          660,
          440
        ]
      },
      {
        "parameters": {
          "content": "Called by the dashboard when you click Approve on a video that is rendered but not on YouTube yet: uploads it with the privacy in the request (Public) and sets the thumbnail for compilations. Only requests with the shared secret are accepted. Keep this workflow ACTIVE.",
          "width": 520,
          "height": 130
        },
        "id": "u-note",
        "name": "Notes",
        "type": "n8n-nodes-base.stickyNote",
        "typeVersion": 1,
        "position": [
          200,
          80
        ]
      }
