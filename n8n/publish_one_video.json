[
  {
    "id": "gta6PublishOne01",
    "name": "Clip Studio - Publish one video (manual)",
    "active": false,
    "settings": {
      "executionOrder": "v1"
    },
    "nodes": [
      {
        "parameters": {},
        "id": "m-man",
        "name": "Manual run",
        "type": "n8n-nodes-base.manualTrigger",
        "typeVersion": 1,
        "position": [
          200,
          300
        ]
      },
      {
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "a1",
                "name": "video_id",
                "value": "PASTE-VIDEO-ID-HERE",
                "type": "string"
              }
            ]
          },
          "options": {}
        },
        "id": "m-pick",
        "name": "Pick video",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [
          420,
          300
        ]
      },
      {
        "parameters": {
          "url": "=http://127.0.0.1:8765/api/videos/{{ $json.video_id }}",
          "options": {}
        },
        "id": "m-get",
        "name": "Get video record",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          640,
          300
        ]
      },
      {
        "parameters": {
          "method": "PUT",
          "url": "https://www.googleapis.com/youtube/v3/videos?part=status",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "youTubeOAuth2Api",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={ \"id\": \"{{ $('Get video record').item.json.youtube_id }}\", \"status\": { \"privacyStatus\": \"public\", \"embeddable\": true, \"publicStatsViewable\": true, \"license\": \"youtube\", \"selfDeclaredMadeForKids\": false } }",
          "options": {}
        },
        "id": "p-yt",
        "name": "Set video Public",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          860,
          300
        ],
        "credentials": {
          "youTubeOAuth2Api": {
            "id": "gta6YtCred01",
            "name": "YouTube - GTA6 Studio"
          }
        }
      },
      {
        "parameters": {
          "method": "PATCH",
          "url": "=http://127.0.0.1:8765/api/videos/{{ $('Pick video').item.json.video_id }}",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "X-Requested-With",
                "value": "studio"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={ \"status\": \"public\", \"privacy_status\": \"public\" }",
          "options": {}
        },
        "id": "m-rep",
        "name": "Mark public in dashboard",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1080,
          300
        ]
      },
      {
        "parameters": {
          "content": "Makes ONE already-uploaded video Public. Put its dashboard video id in 'Pick video', then Execute.",
          "width": 440,
          "height": 100
        },
        "id": "m-note",
        "name": "Notes",
        "type": "n8n-nodes-base.stickyNote",
        "typeVersion": 1,
        "position": [
          200,
          120
        ]
      }
    ],
    "connections": {
      "Manual run": {
        "main": [
          [
            {
              "node": "Pick video",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Pick video": {
        "main": [
          [
            {
              "node": "Get video record",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Get video record": {
        "main": [
          [
            {
              "node": "Set video Public",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Set video Public": {
        "main": [
          [
            {
              "node": "Mark public in dashboard",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    }
  }
]